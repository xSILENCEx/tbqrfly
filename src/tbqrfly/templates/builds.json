{
  "app_name": "App",
  "default_env": "dev",
  "wait_timeout": 10,
  "artifacts": {
    "android": [
      "build/app/outputs/flutter-apk/app-arm64-v8a-*-release.apk"
    ],
    "ios": [
      "build/ios/ipa/*.ipa"
    ]
  },
  "builds": {
    "dev": {
      "android": {
        "zealot_channel_key": "",
        "build_command": "flutter build apk --release --split-per-abi --flavor dev"
      },
      "ios": {
        "zealot_channel_key": "",
        "build_command": "flutter build ipa --release --flavor dev",
        "export_options": ""
      }
    },
    "prod": {
      "android": {
        "zealot_channel_key": "",
        "build_command": "flutter build apk --release --split-per-abi --flavor prod"
      },
      "ios": {
        "zealot_channel_key": "",
        "build_command": "flutter build ipa --release --flavor prod",
        "export_options": ""
      }
    }
  }
}
