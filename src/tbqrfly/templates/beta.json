{
  "app_name": "App",
  "wait_timeout": 10,
  "terminal": "auto",
  "pre_commands": [],
  "next_commands": [],
  "builds": {
    "ios": {
      "pre_commands": [],
      "build_command": "flutter build ipa --release --flavor prod --dart-define=FLAVOR=prod",
      "export_options": "ios/ExportOptions-AppStore.plist",
      "artifacts": ["build/ios/ipa/*.ipa"],
      "publish": {
        "provider": "testflight",
        "bundle_id": "",
        "key_id": "${ASC_KEY_ID}",
        "issuer_id": "${ASC_ISSUER_ID}",
        "key_file": "${ASC_KEY_FILE}"
      },
      "next_commands": []
    }
  }
}
