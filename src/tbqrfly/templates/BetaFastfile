default_platform(:ios)

platform :ios do
  lane :tbqrfly_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('TBQRFLY_ASC_KEY_ID'),
      issuer_id: ENV.fetch('TBQRFLY_ASC_ISSUER_ID'),
      key_filepath: ENV.fetch('TBQRFLY_ASC_KEY_FILE'),
      in_house: false
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: ENV.fetch('TBQRFLY_BETA_IPA'),
      app_identifier: ENV.fetch('TBQRFLY_BETA_BUNDLE_ID'),
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  lane :tbqrfly_upload do
    upload_to_play_store(
      json_key: ENV.fetch('TBQRFLY_PLAY_SERVICE_ACCOUNT_FILE'),
      package_name: ENV.fetch('TBQRFLY_PLAY_PACKAGE_NAME'),
      aab: ENV.fetch('TBQRFLY_BETA_AAB'),
      track: 'internal',
      release_status: ENV.fetch('TBQRFLY_PLAY_RELEASE_STATUS'),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
